{
  "expo": {
    "name": "FCN Fans",
    "slug": "fcn-fans-mvp",
    "scheme": "fcnfans",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/NewLogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "dk.rasmusgunnar.fcnfans",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dk.rasmusgunnar.fcnfans"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-notifications", "@react-native-community/datetimepicker", "expo-font"],
    "extra": {
      "eas": {
        "projectId": "4e547ae8-bdfc-498a-872e-310c90386a38"
      }
    },
    "runtimeVersion": "2",
    "updates": {
      "url": "https://u.expo.dev/4e547ae8-bdfc-498a-872e-310c90386a38"
    }
  }
}
