{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2020",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "./build/instagram-embed-tests",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/types/externalShare.ts",
    "src/types/instagramEmbed.ts",
    "src/types/news.ts",
    "src/lib/instagram.ts",
    "src/utils/instagramEmbed.ts",
    "src/utils/__tests__/instagramEmbed.test.ts",
    "supabase/functions/instagram_oembed/core.ts",
    "supabase/functions/instagram_oembed/core.test.ts"
  ],
  "exclude": []
}
