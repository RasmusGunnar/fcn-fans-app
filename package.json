{
  "name": "fcn-fans-mvp",
  "version": "0.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start",
    "start:demo": "node scripts/run-expo-mode.cjs demo start",
    "start:production": "node scripts/run-expo-mode.cjs production start",
    "android:demo": "node scripts/run-expo-mode.cjs demo run:android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:home-feed-filter": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/homeFeedFilter.test.js",
    "test:home-feed-query": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/homeFeedQuery.test.js",
    "test:home-feed-ranking": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/homeFeedRanking.test.js",
    "test:community-feed": "tsc -p tsconfig.media-article-tests.json && node --test build/media-article-tests/utils/__tests__/communityFeed.test.js",
    "test:fan-post-badge": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/fanPostBadge.test.js",
    "test:weekly-top-fan-api": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/services/__tests__/weeklyTopFanApiFallback.test.js",
    "test:sync-fan-levels": "tsc -p tsconfig.sync-fan-level-tests.json && node build/sync-fan-level-tests/supabase/functions/_shared/__tests__/fanLevelScoring.test.js",
    "test:weekly-top-fan": "tsc -p tsconfig.weekly-top-fan-tests.json && node build/weekly-top-fan-tests/supabase/functions/_shared/__tests__/weeklyTopFanSelection.test.js",
    "test:media-article": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/mediaArticle.test.js",
    "test:media-article-admin": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/mediaArticleAdmin.test.js",
    "test:media-article-candidates": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/mediaArticleCandidates.test.js && node build/media-article-tests/utils/__tests__/mediaArticleCandidateList.test.js && node build/media-article-tests/utils/__tests__/mediaArticleApprovalError.test.js && tsc -p tsconfig.media-article-candidate-core-tests.json && node build/media-article-candidate-tests/supabase/functions/_shared/__tests__/mediaArticleCandidateCore.test.js && node build/media-article-candidate-tests/supabase/functions/_shared/__tests__/newsMedia.test.js",
    "test:post-media": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/postMediaMapping.test.js",
    "test:feed-video": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/videoPlaybackBehavior.test.js",
    "test:feed-media-stability": "tsc -p tsconfig.media-article-tests.json && node --test build/media-article-tests/utils/__tests__/feedMediaStability.test.js",
    "test:song-audio": "tsc -p tsconfig.song-audio-tests.json && node build/song-audio-tests/utils/__tests__/songAudio.test.js",
    "test:direct-messages": "tsc -p tsconfig.direct-message-tests.json && node build/direct-message-tests/utils/__tests__/directMessages.test.js",
    "test:instagram-sharing": "tsc -p tsconfig.instagram-sharing-tests.json && node build/instagram-sharing-tests/utils/__tests__/instagramSharing.test.js",
    "test:instagram-rich": "tsc -p tsconfig.instagram-embed-tests.json && node build/instagram-embed-tests/src/utils/__tests__/instagramEmbed.test.js && node build/instagram-embed-tests/supabase/functions/instagram_oembed/core.test.js",
    "typecheck:instagram-rich": "tsc -p tsconfig.instagram-embed-ui.json",
    "test:stadium-live": "tsc -p tsconfig.stadium-live-tests.json && node build/stadium-live-tests/utils/__tests__/stadiumLive.test.js",
    "test:demo-mode": "tsc -p tsconfig.demo-mode-tests.json && node build/demo-mode-tests/demo/__tests__/demoMode.test.js && node build/demo-mode-tests/demo/__tests__/shotFlowSmoke.test.js",
    "typecheck:stadium-live": "tsc -p tsconfig.stadium-live-ui.json",
    "db:hosted": "echo \"⚠️  Use Supabase Dashboard SQL Editor + supabase/CHANGELOG_MANUAL.sql for hosted DB changes. Do NOT run 'db push' without Docker setup.\"",
    "design:check": "node scripts/design-check.js"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
