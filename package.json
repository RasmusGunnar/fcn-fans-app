{
  "name": "fcn-fans-mvp",
  "version": "0.1.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:home-feed-filter": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/homeFeedFilter.test.js",
    "test:community-feed": "tsc -p tsconfig.media-article-tests.json && node --test build/media-article-tests/utils/__tests__/communityFeed.test.js",
    "test:media-article": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/mediaArticle.test.js",
    "test:media-article-admin": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/mediaArticleAdmin.test.js",
    "test:media-article-candidates": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/mediaArticleCandidates.test.js && node build/media-article-tests/utils/__tests__/mediaArticleCandidateList.test.js && node build/media-article-tests/utils/__tests__/mediaArticleApprovalError.test.js && tsc -p tsconfig.media-article-candidate-core-tests.json && node build/media-article-candidate-tests/supabase/functions/_shared/__tests__/mediaArticleCandidateCore.test.js",
    "test:post-media": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/postMediaMapping.test.js",
    "test:feed-video": "tsc -p tsconfig.media-article-tests.json && node build/media-article-tests/utils/__tests__/videoPlaybackBehavior.test.js",
    "db:hosted": "echo \"⚠️  Use Supabase Dashboard SQL Editor + supabase/CHANGELOG_MANUAL.sql for hosted DB changes. Do NOT run 'db push' without Docker setup.\"",
    "design:check": "node scripts/design-check.js"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "^2.90.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-av": "~16.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.10",
    "jsonwebtoken": "^9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.0",
    "prettier": "^3.6.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  }
}
